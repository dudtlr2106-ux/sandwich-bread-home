# mock | smartthings
IOT_MODE=mock

# SmartThings Cloud API. Server-side only. Never prefix with NEXT_PUBLIC_.
SMARTTHINGS_TOKEN=
SMARTTHINGS_BASE_URL=https://api.smartthings.com/v1

# Optional: limits devices to one SmartThings Location.
SMARTTHINGS_LOCATION_ID=

# One-time OAuth setup. Keep pat until all OAuth settings are provisioned.
SMARTTHINGS_AUTH_MODE=pat
APP_ORIGIN=https://sandwich-bread-home.vercel.app
SMARTTHINGS_CLIENT_ID=
SMARTTHINGS_CLIENT_SECRET=
# 32 random bytes, base64 encoded. Never rotate without migrating encrypted tokens.
SMARTTHINGS_ENCRYPTION_KEY=
# Family access password, at least 16 characters. Changing it invalidates browser sessions.
HOME_ACCESS_KEY=
# Durable Upstash Redis (Vercel Marketplace). KV_REST_API_URL/TOKEN also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
